# Utility command for edit_cache

build tflite_build/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/pi/chess/akkad/picoKeras/debian/build/tflite_build && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build tflite_build/edit_cache: phony tflite_build/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build tflite_build/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/pi/chess/akkad/picoKeras/debian/build/tflite_build && /usr/bin/cmake --regenerate-during-build -S/home/pi/chess/akkad/picoKeras/debian -B/home/pi/chess/akkad/picoKeras/debian/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build tflite_build/rebuild_cache: phony tflite_build/CMakeFiles/rebuild_cache.util


