Implementar MCTS (Monte Carlo Tree Search) con una Red Neuronal de Grafos (GNN) cambia la forma en que la IA "ve" el ajedrez. En lugar de procesar una imagen fija de 8x8 (como en una CNN), tratamos el tablero como un grafo dinámico donde cada pieza (o casilla ocupada) es un nodo y las interacciones tácticas (ataques, defensas, rayos X) son las aristas.
Este enfoque es muy eficiente para luego portar a microcontroladores como la Raspberry Pi Pico porque en una partida real hay como máximo 32 nodos (y en el medio juego o final, muchos menos), evitando gastar cómputo en casillas vacías.

1. Representación del Tablero como Grafo

Para construir el grafo de una posición usando python-chess, definimos:
• Nodos (X): Cada pieza sobre el tablero. Su vector de características (ej. 16 features) incluye tipo de pieza (one-hot), color, fila (rank), columna (file) y movilidad.
• Aristas (Edge Index y Edge Features): Conexiones dirigidas entre piezas. Por ejemplo:
	• Tipo 1: La pieza A ataca a la pieza B (enemiga).
	• Tipo 2: La pieza A defiende a la pieza B (aliada).
	• Tipo 3: Rayos X o clavada potencial (alineación en fila, columna o diagonal).

2. Ejemplo Completo en Python (PyTorch + python-chess)

Aquí tienes una implementación autocontenida (sin necesidad de librerías pesadas como PyTorch Geometric, usando multiplicación dispersa pura que luego es trivial traducir a C):
python
import math
import chess
import torch
import torch.nn as nn
import torch.nn.functional as F

# ==========================================
# 1. CONVERSIÓN DE TABLERO A GRAFO
# ==========================================
PIECE_TO_IDX = {
    chess.PAWN: 0, chess.KNIGHT: 1, chess.BISHOP: 2,
    chess.ROOK: 3, chess.QUEEN: 4, chess.KING: 5
}

def board_to_graph(board: chess.Board):
    """Extrae nodos (piezas) y matriz de adyacencia de ataques/defensas."""
    squares = list(board.piece_map().keys())
    num_nodes = len(squares)
    sq_to_node = {sq: i for i, sq in enumerate(squares)}

    # Características de nodo: [6 tipos pieza, 1 color, 1 fila_norm, 1 col_norm] = 9 features
    node_feats = torch.zeros((num_nodes, 9), dtype=torch.float32)
    
    # Matrices de adyacencia (Ataques y Defensas)
    adj_attack = torch.zeros((num_nodes, num_nodes), dtype=torch.float32)
    adj_defend = torch.zeros((num_nodes, num_nodes), dtype=torch.float32)

    for i, sq in enumerate(squares):
        piece = board.piece_at(sq)
        node_feats[i, PIECE_TO_IDX[piece.piece_type]] = 1.0
        node_feats[i, 6] = 1.0 if piece.color == board.turn else -1.0
        node_feats[i, 7] = chess.square_rank(sq) / 7.0
        node_feats[i, 8] = chess.square_file(sq) / 7.0

        # Buscar a qué otras piezas ataca o defiende esta pieza
        for target_sq in board.attacks(sq):
            if target_sq in sq_to_node:
                j = sq_to_node[target_sq]
                target_piece = board.piece_at(target_sq)
                if target_piece.color != piece.color:
                    adj_attack[i, j] = 1.0
                else:
                    adj_defend[i, j] = 1.0

    # Añadir auto-conexiones (self-loops)
    eye = torch.eye(num_nodes)
    return node_feats, adj_attack + eye, adj_defend + eye, sq_to_node

# ==========================================
# 3. RED NEURONAL DE GRAFOS (DOS CABEZAS)
# ==========================================
class ChessGNN(nn.Module):
    def __init__(self, in_features=9, hidden_dim=32):
        super().__init__()
        # Capa de paso de mensajes (Message Passing)
        self.W_self = nn.Linear(in_features, hidden_dim)
        self.W_attack = nn.Linear(in_features, hidden_dim, bias=False)
        self.W_defend = nn.Linear(in_features, hidden_dim, bias=False)

        # Segunda capa de propagación
        self.W2_self = nn.Linear(hidden_dim, hidden_dim)
        self.W2_attack = nn.Linear(hidden_dim, hidden_dim, bias=False)

        # Cabeza de Valor (Evaluación global del grafo -> [-1, 1])
        self.value_head = nn.Sequential(
            nn.Linear(hidden_dim, 16),
            nn.ReLU(),
            nn.Linear(16, 1),
            nn.Tanh()
        )

        # Cabeza de Política (Puntúa pares origen -> destino)
        self.policy_head = nn.Linear(hidden_dim * 2, 1)

    def forward(self, x, adj_att, adj_def, legal_moves, sq_to_node):
        # Paso de mensajes 1: cada pieza agrega info de quien la ataca y defiende
        h = F.relu(
            self.W_self(x) + 
            torch.matmul(adj_att, self.W_attack(x)) + 
            torch.matmul(adj_def, self.W_defend(x))
        )
        # Paso de mensajes 2: propagación a 2 saltos (ej. clavadas o ataques descubiertos)
        h = F.relu(self.W2_self(h) + torch.matmul(adj_att, self.W2_attack(h)))

        # --- CABEZA DE VALOR (Global Mean Pooling) ---
        graph_embedding = h.mean(dim=0)
        value = self.value_head(graph_embedding)

        # --- CABEZA DE POLÍTICA (Por movimiento legal) ---
        move_logits = []
        for move in legal_moves:
            from_idx = sq_to_node[move.from_square]
            from_emb = h[from_idx]
            # Si es captura, usamos el embedding de la pieza capturada; si no, vector cero
            to_emb = h[sq_to_node[move.to_square]] if move.to_square in sq_to_node else torch.zeros_like(from_emb)
            pair_emb = torch.cat([from_emb, to_emb], dim=0)
            move_logits.append(self.policy_head(pair_emb))

        policy_probs = F.softmax(torch.stack(move_logits).squeeze(-1), dim=0)
        return policy_probs, value.item()

# ==========================================
# 4. INTEGRACIÓN CON MCTS (PUCT)
# ==========================================
class MCTSNode:
    def __init__(self, prior=0.0):
        self.prior = prior
        self.visits = 0
        self.value_sum = 0.0
        self.children = {}  # {chess.Move: MCTSNode}

    def q_value(self):
        return self.value_sum / self.visits if self.visits > 0 else 0.0

def mcts_search(root_board: chess.Board, model: ChessGNN, simulations=50, c_puct=1.4):
    root = MCTSNode()

    for _ in range(simulations):
        node = root
        board = root_board.copy()
        search_path = [node]

        # 1. SELECCIÓN (PUCT)
        while node.children:
            best_score = -float('inf')
            best_move, best_child = None, None
            sqrt_total = math.sqrt(node.visits)

            for move, child in node.children.items():
                u = c_puct * child.prior * sqrt_total / (1 + child.visits)
                # Invertimos Q porque el hijo representa el turno del oponente
                score = -child.q_value() + u
                if score > best_score:
                    best_score, best_move, best_child = score, move, child

            board.push(best_move)
            node = best_child
            search_path.append(node)

        # 2. EXPANSIÓN Y EVALUACIÓN CON GNN
        if not board.is_game_over():
            legal_moves = list(board.legal_moves)
            x, adj_att, adj_def, sq_to_node = board_to_graph(board)
            with torch.no_grad():
                probs, value = model(x, adj_att, adj_def, legal_moves, sq_to_node)

            for move, prob in zip(legal_moves, probs):
                node.children[move] = MCTSNode(prior=prob.item())
        else:
            res = board.result()
            value = 1.0 if res == "1-0" else (-1.0 if res == "0-1" else 0.0)
            if board.turn == chess.BLACK:
                value = -value

        # 3. RETROPROPAGACIÓN (Backpropagation)
        for n in reversed(search_path):
            n.visits += 1
            n.value_sum += value
            value = -value

    # Elegir la jugada más visitada
    best_move = max(root.children.items(), key=lambda item: item[1].visits)[0]
    return best_move

# --- PRUEBA RÁPIDA ---
board = chess.Board()
gnn_model = ChessGNN(in_features=9, hidden_dim=32)
jugada = mcts_search(board, gnn_model, simulations=30)
print(f"Mejor jugada sugerida por MCTS + GNN: {jugada}")
